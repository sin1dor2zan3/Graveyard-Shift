MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3815081172679754799}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "PACK THE ORDER\nCheck the customer\u2019s request. Drag gifts into the
    parcel and use Rotate to turn them.\n\nPROTECT FRAGILE GIFTS\nLeave one cell
    of space along every edge of fragile gifts. Fill those spaces with peanuts. Box
    walls and other gifts do not count as protection. Diagonal corners do not need
    padding.\n\nUSE THE SCOOP\nDrag the scoop into the bin to fill it. Drop it over
    an empty parcel cell to cushion a nearby 3 \xD7 3 area.\n\nCHECK YOUR WORK\nThe
    protection icon shows whether a fragile gift is safe. Toggle Grid shows placement
    guides.\n\nCOMPLETE YOUR SHIFT\nMissing gifts, unmet requests, damaged gifts,
    and overspending cause failed orders. Complete three deliveries to see your shift
    results."
